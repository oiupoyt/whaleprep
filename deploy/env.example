# Copy to .env next to the binary (repo root on the host) and fill in.
# The start script sources this file; it is git-ignored, never committed.
#
# How to get these (5 minutes, needs a Google account):
# 1. Open https://console.cloud.google.com/apis/credentials
# 2. Create Credentials -> OAuth client ID -> Web application.
# 3. Under "Authorised JavaScript origins" add exactly:
#      https://whaleprep.oiupoyt.space
#    Under "Authorised redirect URIs" add exactly:
#      https://whaleprep.oiupoyt.space/student/google/callback
# 4. Paste the client ID and secret below, restart the service.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
